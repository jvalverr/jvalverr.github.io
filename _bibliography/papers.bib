@inproceedings{valverde2027urban,
  bibtex_show = {true},
  abbr        = {ACDSA},
  title       = {Urban Representation Learning for Identifying Potential Disparities in Crime Reporting},
  author      = {Valverde-Rebaza, Jorge and Paez De La Cruz, C. and P{\'e}rez-Collado, P. and S{\'a}nchez-Cata{\~n}o, D. and Mart{\'\i}nez-Vergara, E.},
  booktitle   = {Proceedings of the International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA 2027)},
  year        = {2027},
  publisher   = {IEEE},
  note        = {Accepted, to be published},
  abstract    = {Open crime data are widely used to analyze urban safety, yet they reflect reported incidents rather than the complete distribution of criminal activity. Differences in reporting behavior across urban areas can therefore introduce spatial distortions that affect subsequent analysis and decision-making. This work addresses this problem through a self-supervised urban representation learning framework that identifies regions with anomalous reporting patterns relative to functionally similar areas. The approach combines multi-scale reporting characteristics with a latent representation of urban regions and uses Neighbor Profile Divergence (NPD) to quantify departures from expected peer behavior. Experiments on large-scale crime data from Mexico City show that the learned representation is consistently more structured than linear, neural, and spatial baselines, while NPD remains stable across alternative neighborhood configurations. High-divergence regions exhibit spatially coherent patterns and often differ from comparable areas in both reporting structure and incident volume, supporting their use as candidates for further investigation.},
  selected    = {false}
}

@inproceedings{barreto2027decision,
  bibtex_show = {true},
  abbr        = {ACDSA},
  title       = {Decision Assurance for AI-Assisted Flight Plan Generation in Air Traffic Management},
  author      = {Barreto, A. and Matsumoto, S. and Valverde-Rebaza, Jorge and Ataide, C. and Costa, P.},
  booktitle   = {Proceedings of the International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA 2027)},
  year        = {2027},
  publisher   = {IEEE},
  note        = {Accepted, to be published},
  abstract    = {Generative AI is increasingly being used informally in Air Traffic Management (ATM) for tasks such as flight plan generation, trajectory interpretation, and constraint checking. Although these tools can reduce workload and accelerate planning, their non-deterministic outputs create safety and operational risks in human-in-the-loop settings. This paper proposes the AI Trust and Assurance Layer (ATAL), a model-agnostic decision assurance architecture that evaluates whether AI-generated flight-planning outputs are sufficiently reliable for operational use. ATAL combines semantic stability under prompt variation, operational consistency of structured outputs, and normative constraint validation against domain rules, and maps these signals to a Decision Readiness Level (DRL) for human operators. An ATM-inspired experimental study shows how unsafe, inconsistent, or misleading outputs can be identified before influencing flight-plan validation or execution. Although demonstrated in aviation, the framework is also transferable to other safety-critical decision-support domains that require human oversight under regulatory constraints.},
  selected    = {false}
}

@inproceedings{delima2026aethon,
  bibtex_show = {true},
  abbr        = {BTSym},
  title       = {AETHON: Deterministic Pre-Inference Defense for LLM Prompt Injection},
  author      = {de Lima, L. B. and Valverde-Rebaza, Jorge and Barreto, A. and Iano, Y.},
  booktitle   = {Proceedings of the 12th Brazilian Technology Symposium (BTSym 2026): Emerging Trends and Challenges in Technology},
  series      = {Smart Innovation, Systems and Technologies},
  year        = {2026},
  publisher   = {Springer Nature},
  note        = {To be published},
  abstract    = {Prompt injection exploits a structural weakness of LLM-integrated applications: untrusted natural language can be interpreted as both data and control. This paper presents AETHON, a lightweight model-agnostic middleware that enforces a pre-inference security decision using deterministic rules and a TF--IDF/logistic-regression detector. A calibrated cascade score, s(x)=max\{H(x),p(x)\}, preserves the operational logical-OR policy while supporting threshold-independent evaluation. The detector was frozen after training on 546 prompts and calibration on 116 validation prompts, with Platt scaling and a validation-selected threshold of τ=0.47. We then evaluated the frozen detector on 7,064 observations from four external benchmarks. AETHON reached a macro TPR of 0.8098 with sub-millisecond median cascade latency, but its overall FPR was 0.6924, its NotInject FPR was 0.6991, and its external macro AUROC was 0.5500, compared with 0.9515 on validation. The heuristic layer added no thresholded detections beyond the supervised detector in the frozen evaluation. The results show that deterministic pre-inference enforcement is inexpensive and auditable, but validation-selected calibration does not reliably transfer across heterogeneous prompt distributions. AETHON therefore exposes over-defense and cross-dataset generalization as first-class guardrail evaluation requirements.},
  selected    = {false}
}

@inproceedings{valverde2026cultural,
  bibtex_show = {true},
  abbr        = {CLEI},
  title       = {Evaluating Cultural Reasoning and Robustness in LLMs for Spanish Political Discourse},
  author      = {Valverde-Rebaza, Jorge and Garcia-Larios, N. and Ruvalcaba-P{\'e}rez, K. and Rend{\'o}n, A. and S{\'a}nchez-Ballesteros, S. and Martin del Campo, A.},
  booktitle   = {Proceedings of the 52nd Latin American Conference on Informatics (CLEI 2026)},
  year        = {2026},
  note        = {To be published},
  abstract    = {Large language models (LLMs) are increasingly used to interpret, generate, and mediate public-facing language, which makes their reliability especially consequential in politically sensitive settings. Although sentiment analysis is a common task in this area, affective meaning in social media discourse is often conveyed through culturally situated and pragmatically indirect cues that are not well captured by label-centric evaluation alone. In this paper, we evaluate the robustness of LLMs for sentiment analysis of Spanish political discourse from social media, with emphasis on culturally situated affective interpretation. We introduce a diagnostic protocol that combines three independent human annotation views into Gold and Ambiguous subsets, and extends the corpus with a Synthetic subset built from sentiment-flipped counterfactuals selected through model-conditioned perplexity and LLM-as-a-judge criteria. Using this framework, we compare proprietary and open-weight models under zero-shot and few-shot prompting, focusing on predictive robustness across human agreement conditions and counterfactual shift. Our results show that annotation ambiguity and counterfactual perturbation reveal failure modes that conventional evaluation on the original corpus tends to obscure. GPT-4.1-mini remains the most stable among the evaluated models, whereas the two smaller open-weight models degrade more markedly under synthetic perturbations, and few-shot prompting provides only limited gains. Overall, the paper contributes a reproducible protocol for robustness-oriented evaluation in political sentiment analysis, an empirical characterization of model behavior under ambiguity and sentiment-flipped counterfactuals, and a publicly available Spanish social media dataset with three-way human sentiment annotations.},
  selected    = {false}
}

